    {
      "parameters": {
        "jsCode": "// Ensure input exists\nlet text = $json.cleanText || \"\";\nif (text.length === 0) {\n  return [{\n    json: {\n      chunk: \"No content available\"\n    }\n  }];\n}\nif (text.length > 60000) {\n  text = text.slice(0, 60000);\n}\nif (!text || typeof text !== \"string\") {\n  throw new Error(\"cleanText is missing or not a string\");\n}\n\nconst maxChunks = 5;\nconst chunkSize = 12000;\n\nlet chunks = [];\nlet i = 0;\n\nwhile (i < text.length && chunks.length < maxChunks) {\n  let chunk = text.slice(i, i + chunkSize);\n\n  // Try to end at last full stop for cleaner split\n  const lastPeriod = chunk.lastIndexOf(\".\");\n  if (lastPeriod > 5000) {\n    chunk = chunk.slice(0, lastPeriod + 1);\n  }\n\n  chunks.push(chunk);\n  i += chunk.length;\n}\n\n// Return in correct n8n format\nreturn chunks.map(c => ({\n  json: {\n    chunk: c\n  }\n}));"
      },
